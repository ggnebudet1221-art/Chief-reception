{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Manager",
  "version": "0.1.0",
  "identifier": "com.aimanager.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8000/",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "AI Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
