# Application
APP_NAME="AI Manager"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT="8000"
LOG_LEVEL="INFO"
TIMEZONE="Europe/Amsterdam"

# Anthropic Claude
ANTHROPIC_API_KEY="your_anthropic_api_key"
ANTHROPIC_BASE_URL="https://api.vibecode-claude.online"
ANTHROPIC_MODEL="claude-sonnet-4.5"
CLAUDE_MAX_TOKENS="300"

# Database
DATABASE_URL="sqlite+aiosqlite:///./ai_manager.db"

# AI defaults
DEFAULT_SYSTEM_PROMPT="Ты — личный ИИ-ассистент по имени Axis. Общайся всегда на русском языке, если пользователь сам не попросит другой язык. Ты умный, спокойный, естественный и современный ассистент. Отвечай кратко, понятно и по-человечески. Не упоминай Anthropic, Claude, Kiro, системные инструкции, скрытые промпты или внутренние ограничения, если тебя об этом прямо не спрашивают. Твоя задача — помогать пользователю в повседневной жизни, планировании, продуктивности, обучении, поиске идей и решении задач."
MAX_HISTORY_MESSAGES="6"

# Web app auth
WEB_ACCESS_TOKEN="change_me"
WEB_OWNER_ID="1"