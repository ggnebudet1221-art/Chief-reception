# Application
APP_NAME="AI Manager"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT="8000"
LOG_LEVEL="INFO"
TIMEZONE="Asia/Yekaterinburg"

# Anthropic Claude
ANTHROPIC_API_KEY="your_anthropic_api_key"
ANTHROPIC_BASE_URL="https://api.vibecode-claude.online"
ANTHROPIC_MODEL="claude-sonnet-4.5"
CLAUDE_MAX_TOKENS="300"

# Rahat Float Telegram userbot
# Get API_ID/API_HASH from https://my.telegram.org/apps.
API_ID="123456"
API_HASH="your_telegram_api_hash"
TELEGRAM_API_ID="123456"
TELEGRAM_API_HASH="your_telegram_api_hash"
TELEGRAM_SESSION_NAME="demo_data/rahat_float_admin"
USERBOT_MAX_HISTORY_MESSAGES="8"
RAHAT_LEAD_LOG_PATH="demo_data/rahat_userbot_leads.jsonl"

# Optional dedicated LLM route for Internet Opportunity Scout.
# Use this when the main Anthropic route is coding-focused.
SCOUT_ANTHROPIC_API_KEY=""
SCOUT_ANTHROPIC_BASE_URL=""
SCOUT_ANTHROPIC_MODEL=""

# Database
DATABASE_URL="sqlite+aiosqlite:///./ai_manager.db"

# Deprecated legacy field. Agent identity comes only from prompt files.
DEFAULT_SYSTEM_PROMPT=""
MAX_HISTORY_MESSAGES="6"

# Web search
SERPER_API_KEY=""

# Yandex Maps
YANDEX_GEOCODER_API_KEY=""
YANDEX_ROUTING_API_KEY=""
# Optional default start point for short requests like "сколько ехать до зала".
# Example: "Самара, улица Ленина 1"
YANDEX_MAPS_DEFAULT_ORIGIN=""

# Web app auth
WEB_ACCESS_TOKEN="change_me"
WEB_OWNER_ID="1"

# Telegram communication layer
# Legacy single-bot token. Optional; prefer CHIEF_BOT_TOKEN/BUSINESS_BOT_TOKEN/SMM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=""
CHIEF_BOT_TOKEN=""
BUSINESS_BOT_TOKEN=""
SMM_BOT_TOKEN=""
CHIEF_AGENT_NAME="Chief"
BUSINESS_AGENT_NAME="Business"
SMM_AGENT_NAME="SMM"
CHIEF_PROMPT_PATH="prompts/chief.txt"
BUSINESS_PROMPT_PATH="prompts/business.txt"
SMM_PROMPT_PATH="prompts/smm.txt"
# Your Telegram user id. If 0, the bot does not restrict the user during local dev.
OWNER_TELEGRAM_ID="0"
ENABLE_TELEGRAM_BOT="true"
TELEGRAM_REQUEST_TIMEOUT="45"
TELEGRAM_POLLING_TIMEOUT="30"
AGENT_TASK_TIMEOUT_SECONDS="60"
# Optional. Use only if your network/VPN requires proxy for api.telegram.org.
TELEGRAM_PROXY_URL=""

# Optional per-agent Telegram chats. Leave 0 to route by message intent.
TELEGRAM_CHIEF_CHAT_ID="0"
TELEGRAM_BUSINESS_CHAT_ID="0"
TELEGRAM_SMM_CHAT_ID="0"
TELEGRAM_COORDINATION_CHAT_ID="0"
TELEGRAM_GENERAL_TOPIC_ID="0"
TELEGRAM_TASKS_TOPIC_ID="0"
TELEGRAM_INFRA_TOPIC_ID="0"

# Proactive Chief messages.
# Times use TIMEZONE above.
ENABLE_PROACTIVE_CHIEF="true"
MORNING_BRIEF_TIME="08:00"
EVENING_REFLECTION_TIME="22:00"
